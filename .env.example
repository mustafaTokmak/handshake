PYDANTIC_AI_GATEWAY_API_KEY=
PYDANTIC_AI_GATEWAY_BASE_URL=https://gateway-eu.pydantic.dev/proxy
HANDSHAKE_MODEL=google/gemma-4-31B-it
REPAIR_GATEWAY_ROUTE=repair-lab
LOGFIRE_TOKEN=
LOGFIRE_BASE_URL=https://logfire-eu.pydantic.dev
HANDSHAKE_LOGFIRE_PROJECT_URL=
CONTACT_CALLBACK_TOKEN=

# Escalation voice caller (caller/). Local-only: the browser holds the Gemini
# Live socket, so the key never leaves this machine.
GOOGLE_API_KEY=
CALLER_MODEL=gemini-3.8-live
CALLER_PORT=8771
# Where the caller relays a typed finding. The deployed lab is
# https://mtokmak06--handshake-live.modal.run; leave it on localhost to rehearse
# against a lab you are running yourself. CONTACT_CALLBACK_TOKEN above must
# match the value the lab enforces.
REPAIR_LAB_URL=https://mtokmak06--handshake-live.modal.run
