PYDANTIC_AI_GATEWAY_API_KEY=
PYDANTIC_AI_GATEWAY_BASE_URL=https://gateway-eu.pydantic.dev/proxy
HANDSHAKE_MODEL=
HANDSHAKE_GATEWAY_ROUTE=modal
# Reference to the actual remote rule/version. Does not prove rule application.
HANDSHAKE_GATEWAY_POLICY_REFERENCE=
LOGFIRE_TOKEN=
